# ===== 数据库 =====
DATABASE_URL=postgresql+psycopg://eaos:eaos_dev_password@localhost:5433/eaos

# ===== LLM（DeepSeek，OpenAI 兼容，可插拔） =====
# 必填：DeepSeek API Key（不提交/不入库）
LLM_API_KEY=
LLM_BASE_URL=https://api.deepseek.com/v1
# 分任务模型配置（MVP 统一 deepseek-chat，可后续换轻量模型降本）
LLM_MODEL_GENERATION=deepseek-chat
LLM_MODEL_EXTRACTION=deepseek-chat
LLM_MODEL_FACTCHECK=deepseek-chat
LLM_TEMPERATURE=0.3
LLM_TIMEOUT=120

# ===== Embedding（OpenAI 兼容接口，独立于 DeepSeek 对话 Key） =====
# 示例：OpenAI https://api.openai.com/v1 + text-embedding-3-small；
# 也可填任一兼容 /v1/embeddings 的服务地址与模型。
EMBEDDING_API_KEY=
EMBEDDING_BASE_URL=https://api.openai.com/v1
EMBEDDING_MODEL=text-embedding-3-small
# 0 表示使用服务实际返回的维度；需要固定维度时填写正整数。
EMBEDDING_DIMENSIONS=0
EMBEDDING_TIMEOUT=60
EMBEDDING_BATCH_SIZE=64

# ===== 应用 =====
APP_ENV=dev
EXPORT_DIR=exports
UPLOAD_DIR=uploads
CORS_ORIGINS=http://localhost:5173

# ===== 情报聚合采集 =====
REDIS_URL=redis://localhost:6379/0
CELERY_ENABLED=false
COLLECTION_USER_AGENT=EAOS-IntelligenceCollector/0.1
COLLECTION_TIMEOUT=20
COLLECTION_MAX_ITEMS=50
COLLECTION_FAILURE_PAUSE_AFTER=3

# ===== P1 舆情分析（Python 为纯 Worker，业务数据经 Java 权威接口读写） =====
OPINION_JAVA_BASE_URL=http://localhost:8080
OPINION_JAVA_TOKEN=eaos-opinion-internal-dev-token
OPINION_INTERNAL_TOKEN=eaos-opinion-internal-dev-token
OPINION_MAX_ARTICLES_PER_SOURCE=200
OPINION_ANALYSIS_BUDGET_PER_JOB=50
# ASR（语音转写）外部服务地址；为空表示未启用
OPINION_ASR_SERVICE_URL=

# ===== P2 会议公开信息整理（Python 为解析与 AI Worker） =====
MEETING_JAVA_BASE_URL=http://localhost:8080
MEETING_JAVA_TOKEN=eaos-meeting-internal-dev-token
MEETING_INTERNAL_TOKEN=eaos-meeting-internal-dev-token
# 多个 RSS 地址使用英文逗号分隔；仅采集标题命中会议 keywords 的条目
MEETING_RSS_URLS=
MEETING_REPORT_MODEL=deepseek-chat
MEETING_CARD_MODEL=deepseek-chat
# 留空时图片资料会标记为解析失败，不伪造识别文本
MEETING_VISION_MODEL=
# 视觉模型 API Key 与 Base URL（GLM 等 OpenAI 兼容服务）；Key 留空时回退 LLM_API_KEY
MEETING_VISION_API_KEY=
MEETING_VISION_BASE_URL=https://open.bigmodel.cn/api/paas/v4
MEETING_ASR_API_KEY=
MEETING_ASR_BASE_URL=https://open.bigmodel.cn/api/paas/v4
MEETING_ASR_MODEL=glm-asr
