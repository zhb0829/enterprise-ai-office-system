{
  "name": "formal_announcement",
  "title": "正式公告",
  "category": "公告",
  "output_format": "markdown",
  "tone_guidelines": "规范公文语体，措辞庄重准确；结构完整，事项、要求、生效信息交代清楚。",
  "sections": [
    { "key": "headline", "name": "标题", "required": true, "hint": "「关于……的公告」式标题" },
    { "key": "opening", "name": "开头", "required": true, "hint": "公告缘由与依据（兹因/为进一步……）" },
    { "key": "matters", "name": "事项说明", "required": true, "hint": "具体事项、关键数据与安排" },
    { "key": "requirements", "name": "执行要求", "required": false, "hint": "相关方需遵守/配合的事项" },
    { "key": "effective", "name": "生效信息", "required": true, "hint": "生效日期及适用范围" },
    { "key": "closing", "name": "落款", "required": false, "hint": "发布单位与日期" }
  ],
  "placeholders": [
    { "key": "event", "name": "事项", "required": true, "source": "eventDesc", "hint": "公告的核心事项" },
    { "key": "生效日期", "name": "生效日期", "required": true, "source": "keyFacts:生效日期", "hint": "何时生效" },
    { "key": "关键数据", "name": "关键数据", "required": false, "source": "keyFactsAny", "hint": "涉及的关键数据" },
    { "key": "发布部门", "name": "发布部门", "required": false, "source": "keyFacts:发布部门", "hint": "落款单位/部门" },
    { "key": "相关人物", "name": "相关人物", "required": false, "source": "people", "hint": "涉及的人物及头衔" }
  ]
}
