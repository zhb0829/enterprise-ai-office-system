{
  "name": "news_release",
  "title": "新闻稿",
  "category": "新闻稿",
  "output_format": "markdown",
  "tone_guidelines": "以媒体报道口吻呈现，导语先行、倒金字塔结构；突出新闻点与核心数据，可适当生动但不得夸张失实。",
  "sections": [
    { "key": "headline", "name": "标题", "required": true, "hint": "一句话概括新闻核心，含关键信息" },
    { "key": "lead", "name": "导语", "required": true, "hint": "首段概括何时、何地、何人、何事及核心数据" },
    { "key": "body", "name": "主体", "required": true, "hint": "展开事件细节、关键数据与意义" },
    { "key": "quote", "name": "引言", "required": false, "hint": "相关负责人引语" },
    { "key": "background", "name": "背景", "required": false, "hint": "公司/产品背景介绍" },
    { "key": "contact", "name": "联系方式", "required": false, "hint": "媒体联系人及方式" }
  ],
  "placeholders": [
    { "key": "event", "name": "事件", "required": true, "source": "eventDesc", "hint": "发生了什么" },
    { "key": "发布日期", "name": "发布日期", "required": true, "source": "keyFacts:发布日期", "hint": "何时发布/发生" },
    { "key": "核心数据", "name": "核心数据", "required": true, "source": "keyFactsAny", "hint": "至少 1 条关键数据（销售目标、用户数等）" },
    { "key": "发言人", "name": "发言人", "required": false, "source": "people", "hint": "引语人物及头衔" },
    { "key": "受众", "name": "目标受众", "required": false, "source": "audience", "hint": "面向媒体/公众" }
  ]
}
