{
  "name": "performance_express",
  "title": "业绩快报",
  "category": "业绩",
  "output_format": "markdown",
  "tone_guidelines": "客观中性的信息披露语体；以数据为主，同比/环比分析清晰；包含必要的风险提示。",
  "sections": [
    { "key": "headline", "name": "标题", "required": true, "hint": "××期间业绩快报" },
    { "key": "highlights", "name": "核心业绩", "required": true, "hint": "报告期核心财务/经营数据" },
    { "key": "analysis", "name": "同比分析", "required": false, "hint": "同比/环比变动及原因" },
    { "key": "business_highlights", "name": "经营亮点", "required": false, "hint": "重点业务进展" },
    { "key": "risk", "name": "风险提示", "required": false, "hint": "数据未经审计等风险提示" },
    { "key": "contact", "name": "联系方式", "required": false, "hint": "投资者关系联系人" }
  ],
  "placeholders": [
    { "key": "event", "name": "业绩事项", "required": true, "source": "eventDesc", "hint": "哪个期间的业绩" },
    { "key": "报告期", "name": "报告期", "required": true, "source": "keyFacts:报告期", "hint": "如 2026 年第二季度" },
    { "key": "核心数据", "name": "核心数据", "required": true, "source": "keyFactsAny", "hint": "营收、净利润等关键数据" },
    { "key": "发言人", "name": "发言人", "required": false, "source": "people", "hint": "管理层人物及头衔" }
  ]
}
