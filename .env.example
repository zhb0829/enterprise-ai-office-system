# ===== 数据库 =====
DATABASE_URL=postgresql+psycopg://eaos:eaos_dev_password@localhost:5433/eaos

# ===== LLM（DeepSeek，OpenAI 兼容，可插拔） =====
# 必填：DeepSeek API Key（不提交/不入库）
LLM_API_KEY=
LLM_BASE_URL=https://api.deepseek.com/v1
# 分任务模型配置（MVP 统一 deepseek-chat，可后续换轻量模型降本）
LLM_MODEL_GENERATION=deepseek-chat
LLM_MODEL_EXTRACTION=deepseek-chat
LLM_MODEL_FACTCHECK=deepseek-chat
LLM_TEMPERATURE=0.3
LLM_TIMEOUT=120

# ===== Embedding（OpenAI 兼容接口，独立于 DeepSeek 对话 Key） =====
# 示例：OpenAI https://api.openai.com/v1 + text-embedding-3-small；
# 也可填任一兼容 /v1/embeddings 的服务地址与模型。
EMBEDDING_API_KEY=
EMBEDDING_BASE_URL=https://api.openai.com/v1
EMBEDDING_MODEL=text-embedding-3-small
# 0 表示使用服务实际返回的维度；需要固定维度时填写正整数。
EMBEDDING_DIMENSIONS=0
EMBEDDING_TIMEOUT=60
EMBEDDING_BATCH_SIZE=64

# Recursive-first chunking. Semantic refinement requires real embeddings.
CHUNK_SEMANTIC_ENABLED=true
CHUNK_SEMANTIC_TRIGGER_SIZE=1200
CHUNK_MIN_SIZE=320
CHUNK_SEMANTIC_SIMILARITY_THRESHOLD=0.42

# ===== P0 Rerank =====
# Remote contract: POST {model, query, documents, top_n}; results[index,relevance_score].
# Empty configuration uses explicitly labelled lexical fallback, not semantic reranking.
RERANK_URL=
# Leave empty to reuse EMBEDDING_API_KEY for the same HTTPS origin only.
# SiliconFlow: RERANK_URL=https://api.siliconflow.cn/v1/rerank
# EMBEDDING_BASE_URL=https://api.siliconflow.cn/v1, EMBEDDING_MODEL=BAAI/bge-m3
RERANK_API_KEY=
RERANK_MODEL=BAAI/bge-reranker-v2-m3
RERANK_TIMEOUT=10
# Optional local CrossEncoder; install requirements-rerank.txt separately.
RERANK_LOCAL_MODEL=
AGENT_TRACE_RETENTION_DAYS=30

# ===== G1 知识图谱（默认关闭：先用 evals.graph_gain 证明增益再开启） =====
# KG_MODEL 留空复用 LLM_MODEL_EXTRACTION，避免多一处模型配置面
KG_ENABLED=false
KG_MODEL=
KG_MAX_HOPS=2
KG_SEED_LIMIT=8
KG_CLAUSE_LIMIT=30
KG_ALIGNMENT_THRESHOLD=0.86
KG_EXTRACT_BUDGET_PER_JOB=50
KG_COMMUNITY_MIN_SIZE=3
KG_MAX_NODES=5000

# ===== G3 租户资源隔离与限流 =====
# 第一道防线在 Java 网关（eaos.rate-limit.*）；这里是 AI 服务自身的兜底防线：
# 令牌桶 + 并发配额，超限返回 429 + Retry-After，不排队、不拖垮全站。
# 关闭仅用于排障与容量测试，生产默认开启。
RATE_LIMIT_ENABLED=true
RATE_LIMIT_RPS=50
RATE_LIMIT_BURST=100
# 0 表示该维度不限制
RATE_LIMIT_MAX_CONCURRENCY=32
RATE_LIMIT_GLOBAL_CONCURRENCY=128
RATE_LIMIT_EXEMPT_PATHS=/api/health,/internal/health,/metrics,/static/,/api/agent/flags
# 按租户覆盖（键为 X-Tenant-Id），JSON：{"tenant-a": {"rps": 5, "burst": 10, "concurrency": 4}}
RATE_LIMIT_TENANT_OVERRIDES=
# 高频拒绝默认不写治理审计表（落库会反噬被保护的服务）；需要留痕时显式打开。
RATE_LIMIT_AUDIT_ENABLED=false

# 耗时链路容量池：LLM / Embedding / Rerank 各自独立线程池 + 有界队列。
# workers=0 表示关闭该池（直通执行）；池满快速失败并走既有降级路径，不无限排队。
LLM_POOL_WORKERS=4
LLM_POOL_QUEUE=8
EMBEDDING_POOL_WORKERS=4
EMBEDDING_POOL_QUEUE=8
RERANK_POOL_WORKERS=2
RERANK_POOL_QUEUE=8

# ===== G5 运行时降级开关 =====
# 环境变量仍是默认值口径；运行时开关只做覆盖，可通过
#   GET/PUT /api/agent/flags[/{name}]（需 agent:audit / agent:admin）热切换，无需重启。
# 启动时先覆盖一组开关（JSON），例如 {"kg": false, "semantic_rerank": false}
RUNTIME_FLAG_OVERRIDES=

# ===== G4 模型分层路由 =====
# 默认关闭，与 G1 图谱同口径：先跑 evals.routing_compare 拿到"延迟/成本改善且质量不降"
# 的证据，再显式开启；运行中可经 /api/agent/flags/model_routing 热切换。
# 三层模型留空表示该层未配置（回落标准层）；标准层留空则复用 LLM_MODEL_GENERATION。
# 未配置任何分层模型时，开启本项也是 no-op（行为与"没有路由"完全一致）。
LLM_ROUTING_ENABLED=false
LLM_MODEL_TIER_LIGHT=
LLM_MODEL_TIER_STANDARD=
LLM_MODEL_TIER_REASONING=
# 复杂度打分阈值：score<=LIGHT_MAX 走轻量层，score>=REASONING_MIN 走旗舰层，其余走标准层
LLM_ROUTING_LIGHT_MAX_SCORE=0
LLM_ROUTING_REASONING_MIN_SCORE=3

# ===== G6 成本核算 =====
# 价格表 JSON：{"<model>": {"input": 元/百万token, "output": 元/百万token}}
# 口径：仅 CNY、仅 per-million-token。未收录的模型成本记 null（不估算、不用 0 顶替），
# 汇总里用 costComplete=false + unpricedModels 显式声明缺口。
# 示例：LLM_PRICE_TABLE={"deepseek-chat":{"input":2,"output":8},"text-embedding-3-small":{"input":0.02,"output":0}}
LLM_PRICE_TABLE=
# 成本查询窗口上限（天）与单次最多扫描的 AgentRun 行数，防止运维查询拖垮业务库
COST_QUERY_MAX_DAYS=90
COST_QUERY_MAX_RUNS=20000

# ===== G7 三角色租户治理分工 =====
# 角色由 Java 网关下发 X-User-Role：platform_admin（管租户）/ tenant_admin（管知识库）/ member（只提问）。
# Python 侧只做收缩：有效权限 = 角色基线 ∩ 网关声明的权限集合；网关未下发角色头时不收紧（过渡期口径）。
# 置 false 可整体回退到"权限集合即事实"的过渡期口径（见 app/agent/access.py）。
TENANT_ROLE_GOVERNANCE_ENABLED=true
# 收口开关：true = 无 X-User-Role 的 /api 请求直接 403（网关全量下发角色头后打开）
TENANT_ROLE_REQUIRED=false
# 角色头有、权限头为空时是否回落到角色基线（默认 false：按"没有权限"处理，避免漏发变放大）
TENANT_ROLE_EMPTY_PERMISSIONS_FALLBACK=false

# ===== G9 LTR 学习排序（依赖 G2 标注数据） =====
# off（RRF 保底）→ shadow（影子：只算分不改序）→ blend（(1-alpha)·RRF + alpha·LTR）。
# 前置条件是 G2 线上回流闭环；上线门禁看样本外 AUC，未达标的模型不允许激活（409）。
# 验收：evals.ltr_compare（--require-gain 为 CI 门禁口径），见 README。
LTR_MODE=off
LTR_BLEND_ALPHA=0.3
LTR_MIN_SAMPLES=50
LTR_MIN_AUC=0.6
LTR_TRAIN_EPOCHS=400
LTR_LEARNING_RATE=0.5

# ===== 应用 =====
APP_ENV=dev
EXPORT_DIR=exports
UPLOAD_DIR=uploads
CORS_ORIGINS=http://localhost:5173
# 服务间令牌：生产环境必须设置为至少 16 个字符的随机值。
AI_INTERNAL_TOKEN=

# ===== 情报聚合采集 =====
REDIS_URL=redis://localhost:6379/0
CELERY_ENABLED=false
# 情报权威数据全部由 Java 管理，Python 经 Java internal API 读写（令牌复用 AI_INTERNAL_TOKEN）
INTELLIGENCE_JAVA_BASE_URL=http://localhost:8080
COLLECTION_USER_AGENT=EAOS-IntelligenceCollector/0.1
COLLECTION_TIMEOUT=20
COLLECTION_MAX_ITEMS=50
COLLECTION_FAILURE_PAUSE_AFTER=3

# ===== P1 舆情分析（Python 为纯 Worker，业务数据经 Java 权威接口读写） =====
OPINION_JAVA_BASE_URL=http://localhost:8080
OPINION_JAVA_TOKEN=
OPINION_INTERNAL_TOKEN=
OPINION_MAX_ARTICLES_PER_SOURCE=200
OPINION_ANALYSIS_BUDGET_PER_JOB=50
# ASR（语音转写）外部服务地址；为空表示未启用
OPINION_ASR_SERVICE_URL=

# ===== P2 会议公开信息整理（Python 为解析与 AI Worker） =====
MEETING_JAVA_BASE_URL=http://localhost:8080
MEETING_JAVA_TOKEN=
MEETING_INTERNAL_TOKEN=
# 多个 RSS 地址使用英文逗号分隔；仅采集标题命中会议 keywords 的条目
MEETING_RSS_URLS=
MEETING_REPORT_MODEL=deepseek-chat
MEETING_CARD_MODEL=deepseek-chat
# 留空时图片资料会标记为解析失败，不伪造识别文本
MEETING_VISION_MODEL=
# 视觉模型 API Key 与 Base URL（GLM 等 OpenAI 兼容服务）；Key 留空时回退 LLM_API_KEY
MEETING_VISION_API_KEY=
MEETING_VISION_BASE_URL=https://open.bigmodel.cn/api/paas/v4
MEETING_ASR_API_KEY=
MEETING_ASR_BASE_URL=https://open.bigmodel.cn/api/paas/v4
MEETING_ASR_MODEL=glm-asr
