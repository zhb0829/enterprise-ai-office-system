# 生产环境变量模板 —— 复制为 deploy/.env 并填入真实密钥后使用。
# 密钥不得提交 Git/镜像；真实值通过部署平台 Secret 或环境变量注入。
# 生成建议：
#   JWT_SECRET / AI_INTERNAL_TOKEN / OPINION_INTERNAL_TOKEN / MEETING_INTERNAL_TOKEN：
#     python -c "import secrets,string;print(''.join(secrets.choice(string.ascii_letters+string.digits) for _ in range(48)))"
#   POSTGRES_PASSWORD / GRAFANA_ADMIN_PASSWORD：同上（>=24 字符随机）

# ---- 数据库 ----
POSTGRES_USER=eaos
POSTGRES_PASSWORD=CHANGE_ME_STRONG_PASSWORD_48CHARS
POSTGRES_DB=eaos

# ---- 应用安全 ----
JWT_SECRET=CHANGE_ME_RANDOM_AT_LEAST_32CHARS
AI_INTERNAL_TOKEN=CHANGE_ME_RANDOM_AT_LEAST_16CHARS
OPINION_INTERNAL_TOKEN=CHANGE_ME_RANDOM_AT_LEAST_16CHARS
MEETING_INTERNAL_TOKEN=CHANGE_ME_RANDOM_AT_LEAST_16CHARS
CORS_ALLOWED_ORIGINS=https://office.example.com,https://admin.example.com

# ---- LLM / Embedding（AI 服务）----
LLM_API_KEY=CHANGE_ME_LLM_KEY
LLM_BASE_URL=https://api.deepseek.com/v1
LLM_MODEL_GENERATION=deepseek-chat
EMBEDDING_API_KEY=CHANGE_ME_EMBEDDING_KEY
EMBEDDING_BASE_URL=https://api.openai.com/v1
EMBEDDING_MODEL=text-embedding-3-small

# ---- 镜像仓库 ----
# CI 使用 Secrets: ACR_REGISTRY / ACR_USERNAME / ACR_PASSWORD（推 admin-server/frontend/frontend-admin、ai-service）
# 部署机拉取镜像：docker login <ACR_REGISTRY> 后 compose 使用
ACR_REGISTRY=registry.example.com/eaos
EAOS_IMAGE_TAG=latest

# ---- 对外入口 ----
GATEWAY_PORT=80
# 若 HTTPS 终止在反向代理/云 LB 层，此处无需配证书；见 docs/production-release-checklist.md

# ---- 可观测性 ----
GRAFANA_ADMIN_PASSWORD=CHANGE_ME_STRONG_PASSWORD
GRAFANA_ALERT_EMAILS=ops@example.com
GF_SMTP_ENABLED=false
GF_SMTP_HOST=
GF_SMTP_USER=
GF_SMTP_PASSWORD=
GF_SMTP_FROM_ADDRESS=
