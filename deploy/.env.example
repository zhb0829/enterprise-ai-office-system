# ============================================================
# 企业AI智能办公系统 — 环境配置占位（复制为 .env 后填写真实值）
# 所有密钥不允许使用默认值，admin-server 启动时会 fail-fast 校验（Q5）
# 生成建议（Linux）：
#   openssl rand -hex 32    # JWT_SECRET
#   openssl rand -hex 16    # AI/OPINION/MEETING_INTERNAL_TOKEN
#   openssl rand -base64 24 # POSTGRES_PASSWORD / GRAFANA_ADMIN_PASSWORD
# ============================================================

# ---- 数据库 ----
POSTGRES_USER=eaos
POSTGRES_PASSWORD=
POSTGRES_DB=eaos

# ---- Java admin-server 密钥（Q5：默认值拒绝启动） ----
# HS256 签名密钥，>= 32 字符，禁止包含 change-me
JWT_SECRET=
# 服务间令牌（Java <-> Python 双向校验），>= 16 字符
AI_INTERNAL_TOKEN=
OPINION_INTERNAL_TOKEN=
MEETING_INTERNAL_TOKEN=

# ---- CORS（Q10）----
# 逗号分隔，含用户端与管理端来源；上线替换为正式域名
CORS_ALLOWED_ORIGINS=https://office.example.com,https://admin.example.com

# ---- Python ai-service LLM 密钥 ----
LLM_API_KEY=
LLM_BASE_URL=https://api.deepseek.com/v1
LLM_MODEL_GENERATION=deepseek-chat
EMBEDDING_API_KEY=
EMBEDDING_BASE_URL=https://api.openai.com/v1
EMBEDDING_MODEL=text-embedding-3-small

# ---- 镜像仓库（Q16：ACR 开通后替换为真实 registry 地址） ----
# CI Secrets: ACR_REGISTRY / ACR_USERNAME / ACR_PASSWORD 推送 main+python 两分支镜像
ACR_REGISTRY=registry.cn-hangzhou.aliyuncs.com/eaos
EAOS_IMAGE_TAG=latest

# ---- 网关 ----
GATEWAY_PORT=80

# ---- 可观测性（Q13/Q18）----
GRAFANA_ADMIN_PASSWORD=
GRAFANA_PORT=3000
# 告警邮件收件人（逗号分隔）；SMTP 服务器/账号部署时提供
GRAFANA_ALERT_EMAILS=ops@example.com
GF_SMTP_ENABLED=false
GF_SMTP_HOST=
GF_SMTP_USER=
GF_SMTP_PASSWORD=
GF_SMTP_FROM_ADDRESS=

# ---- 开发编排 ----
DB_HOST_PORT=5433
